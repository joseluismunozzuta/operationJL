rules_version = '2';

// Reglas para el proyecto Firebase "operationjl".
// Pegar manualmente en: Firebase Console → Firestore Database → Reglas.
//
// Requiere que en Authentication → Sign-in method esté habilitado el
// proveedor "Google" (tanto invitados como admin inician sesión con Google;
// el admin es quien usa la cuenta ADMIN_EMAIL).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'joseluismunozzuta@gmail.com';
    }

    // Instante exacto del evento: 2026-08-05 20:00 America/Lima (UTC-5)
    // == 2026-08-06T01:00:00Z. Si cambias EVENT_DATE_ISO en
    // src/lib/event-config.ts, actualiza también este valor.
    function eventHasStarted() {
      return request.time > timestamp.date(2026, 8, 6) + duration.value(1, 'h');
    }

    match /questions/{questionId} {
      // El banco de preguntas no es información sensible: lectura pública
      // (se necesita para que el cliente sepa cuáles están disponibles).
      allow read: if true;

      // Solo se permite tocar taken/assignedToName — vía la transacción de
      // asignación o la liberación en src/lib/rsvp.ts (esta última ocurre
      // cuando un testigo cambia su respuesta de "sí" a "no").
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taken', 'assignedToName'])
        && request.resource.data.taken is bool
        && (request.resource.data.assignedToName == null || request.resource.data.assignedToName is string);

      // El admin puede editar el texto (corregir una pregunta ya asignada
      // sin tener que borrarla y perder el vínculo con el testigo).
      allow update: if isAdmin();

      // Solo el admin siembra/borra el banco (botón en /admin).
      allow create, delete: if isAdmin();
    }

    match /rsvps/{rsvpId} {
      // El id del documento es el uid de la cuenta de Google del testigo:
      // reenviar el formulario — desde cualquier dispositivo, con la misma
      // cuenta — actualiza su propia declaración en vez de crear un
      // duplicado.
      function isOwnDoc() {
        return request.auth != null && rsvpId == request.auth.uid;
      }

      function isValidRsvp() {
        return request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 80
          && request.resource.data.confirmation in ['si', 'no']
          && request.resource.data.keys().hasOnly(
               ['name', 'confirmation', 'uid', 'photoURL', 'questionId', 'questionText',
                'createdAt', 'turn', 'checkedInAt', 'declaredAt']
             );
      }

      allow create, update: if isOwnDoc() && isValidRsvp();

      // JL marca desde /proyeccion quién ya declaró. Solo puede tocar ese
      // campo: no puede alterar el nombre, la pregunta ni el turno de nadie.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['declaredAt']);

      // Lectura: el admin siempre puede verla (panel); un testigo puede leer
      // su propia declaración (para ver/actualizar su estado y su pregunta);
      // cualquiera puede ver la lista completa solo a partir del instante
      // real del evento (revelación grupal). No es un simple check de UI:
      // Firestore lo rechaza server-side hasta que llegue esa hora de verdad.
      allow read: if isAdmin() || isOwnDoc() || eventHasStarted();

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // Interrogatorio en vivo (trivia tipo Kahoot)
    // ---------------------------------------------------------------------

    function gameState() {
      return get(/databases/$(database)/documents/triviaGame/live).data;
    }

    // Estado del juego: todos necesitan leerlo (pregunta actual, temporizador,
    // resultado). Solo el admin lo escribe.
    match /triviaGame/live {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enunciado y alternativas. Lectura pública PERO limitada a la pregunta
    // que está activa: así nadie puede adelantarse y leer el resto del banco.
    match /triviaQuestions/{questionId} {
      allow read: if isAdmin() || gameState().currentQuestionId == questionId;
      allow write: if isAdmin();
    }

    // La respuesta correcta vive aquí, aislada: NUNCA es legible por un
    // jugador. El admin la lee solo al momento de calificar.
    match /triviaKeys/{questionId} {
      allow read, write: if isAdmin();
    }

    // Una respuesta por pregunta y por persona, inmutable:
    // - el id del documento debe ser {preguntaActual}_{uid}
    // - solo se permite create (nunca update), así no se puede cambiar la
    //   respuesta después de ver el resultado
    // - solo mientras la pregunta esté abierta
    match /triviaResponses/{responseId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && responseId == request.resource.data.questionId + '_' + request.auth.uid
        && gameState().status == 'question'
        && gameState().currentQuestionId == request.resource.data.questionId
        && request.resource.data.optionIndex is int
        && request.resource.data.optionIndex >= 0
        && request.resource.data.optionIndex < gameState().optionCount
        && request.resource.data.keys().hasOnly(
             ['uid', 'name', 'photoURL', 'questionId', 'optionIndex', 'answeredAt']
           );

      allow update: if false;
      allow delete: if isAdmin();
    }

    // Marcador: lectura pública (el podio se ve en la TV y en cada celular),
    // escritura solo del admin — los puntos los calcula su panel.
    match /triviaScores/{uid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contador del turno de declaración, asignado al escanear el QR de la
    // puerta (counters/checkin). Cualquier testigo autenticado puede tomar el
    // siguiente número, pero solo puede incrementarlo de uno en uno — no
    // reescribirlo a un valor arbitrario ni retroceder.
    // Interruptor del interrogatorio de testigos: lectura pública (la TV lo
    // necesita sin sesión), escritura solo del admin.
    match /counters/interrogation {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/checkin {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['lastTurn'])
        && request.resource.data.lastTurn == 1;

      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['lastTurn'])
        && request.resource.data.lastTurn == resource.data.lastTurn + 1;

      allow delete: if isAdmin();
    }

    match /wishlist/{itemId} {
      // Lista de regalos: no es información sensible, lectura pública para
      // que la sección "Evidencia requerida" la muestre a los invitados.
      allow read: if true;

      // Cualquier testigo autenticado puede marcar un elemento "bloqueable"
      // como comprado (para que otros no lo compren también) — pero solo
      // puede tocar esos tres campos, nunca el título/url/imagen/descripción
      // ni el flag "lockable". Desmarcarlo (si al final no lo compró) solo
      // puede hacerlo la misma cuenta que lo marcó (comparando su uid contra
      // purchasedByUid) o el admin — así nadie más puede liberar por error
      // la compra real de otra persona.
      allow update: if request.auth != null
        && resource.data.lockable == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['purchased', 'purchasedByName', 'purchasedByUid'])
        && request.resource.data.purchased is bool
        && (
             request.resource.data.purchased == true
             || isAdmin()
             || request.auth.uid == resource.data.purchasedByUid
           );

      allow create, update, delete: if isAdmin();
    }
  }
}
